# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public URL of the app (used for auth callbacks and Stripe redirect URLs).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave empty to use an embedded PGlite database stored in ./.data/pglite
# (zero setup, great for local dev). Set a Postgres URL for Docker/Neon/RDS.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas_starter
DATABASE_URL=
# PGLITE_DIR=./.data/pglite

# ---------------------------------------------------------------------------
# Google OAuth (optional — the Google button only shows when both are set)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Stripe (use TEST mode keys: sk_test_..., whsec_... from `stripe listen`)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs for the paid plans (see src/config/plans.ts)
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
